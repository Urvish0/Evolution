{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution.dev/schemas/evolution-manifest-v1.0.json",
  "title": "Evolution Intelligence Manifest",
  "description": "Schema for evolution.manifest.json conforming to Intelligence Manifest Specification v1.0",
  "type": "object",
  "required": ["version", "name"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Spec version this manifest conforms to (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the intelligence",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Brief description of what this AI system does"
    },
    "artifacts": {
      "type": "object",
      "description": "Collection of typed AI artifacts",
      "properties": {
        "prompts": {
          "type": "array",
          "items": { "$ref": "#/$defs/prompt_artifact" }
        },
        "memory": {
          "type": "array",
          "items": { "$ref": "#/$defs/memory_artifact" }
        },
        "retrieval": {
          "type": "array",
          "items": { "$ref": "#/$defs/retrieval_artifact" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool_artifact" }
        },
        "model_config": {
          "$ref": "#/$defs/model_config_artifact"
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/$defs/policy_artifact" }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Execution context and environment metadata",
      "properties": {
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "base_artifact": {
      "type": "object",
      "required": ["type", "name", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["prompt", "memory", "retrieval", "tool", "model_config", "policy"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 content hash. Empty string allowed; auto-computed at commit time."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "prompt_artifact": {
      "allOf": [
        { "$ref": "#/$defs/base_artifact" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "prompt" },
            "role": {
              "type": "string",
              "enum": ["system", "user", "assistant", "few_shot"]
            },
            "format": {
              "type": "string",
              "enum": ["text", "template", "jinja2", "mustache"]
            }
          }
        }
      ]
    },
    "memory_artifact": {
      "allOf": [
        { "$ref": "#/$defs/base_artifact" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "memory" },
            "strategy": {
              "type": "string",
              "enum": ["buffer_window", "summary", "vector", "graph"]
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "retrieval_artifact": {
      "allOf": [
        { "$ref": "#/$defs/base_artifact" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "retrieval" },
            "source": {
              "type": "string",
              "enum": ["pinecone", "chroma", "weaviate", "local", "elasticsearch"]
            },
            "chunk_size": {
              "type": "integer",
              "minimum": 1
            },
            "top_k": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "tool_artifact": {
      "allOf": [
        { "$ref": "#/$defs/base_artifact" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool" },
            "provider": {
              "type": "string"
            },
            "auth_required": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "model_config_artifact": {
      "allOf": [
        { "$ref": "#/$defs/base_artifact" },
        {
          "type": "object",
          "required": ["model"],
          "properties": {
            "type": { "const": "model_config" },
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Model identifier (e.g., gpt-4o, claude-3.5-sonnet)"
            },
            "provider": {
              "type": "string",
              "enum": ["openai", "anthropic", "google", "local", "mistral", "cohere", "aws_bedrock"]
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "top_p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "policy_artifact": {
      "allOf": [
        { "$ref": "#/$defs/base_artifact" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "policy" },
            "enforcement": {
              "type": "string",
              "enum": ["strict", "warn", "log"]
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "description": "Records a single AI system invocation at a specific commit snapshot.",
      "required": ["id", "commit_id", "inputs", "outputs", "duration_ms", "tokens", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique execution identifier"
        },
        "commit_id": {
          "type": "string",
          "format": "uuid",
          "description": "Intelligence Commit this execution is bound to"
        },
        "inputs": {
          "type": "string",
          "description": "User input or query"
        },
        "outputs": {
          "type": "string",
          "description": "AI-generated response"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Response latency in milliseconds"
        },
        "tokens": {
          "$ref": "#/$defs/token_usage"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the execution occurred (RFC 3339)"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Custom key-value execution metadata"
        }
      },
      "additionalProperties": false
    },
    "token_usage": {
      "type": "object",
      "description": "Token consumption metrics for an execution.",
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Input token count"
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Output token count"
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Total token count"
        }
      },
      "additionalProperties": false
    },
    "evaluation_result": {
      "type": "object",
      "description": "Scores an execution against one or more quality evaluators.",
      "required": ["id", "commit_id", "execution_id", "overall_score", "scores", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique evaluation identifier"
        },
        "commit_id": {
          "type": "string",
          "format": "uuid",
          "description": "Intelligence Commit this evaluation belongs to"
        },
        "execution_id": {
          "type": "string",
          "format": "uuid",
          "description": "Execution being evaluated"
        },
        "overall_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Aggregate normalized quality score"
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evaluation_score"
          },
          "description": "Map of evaluator name to score detail"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the evaluation was generated (RFC 3339)"
        }
      },
      "additionalProperties": false
    },
    "evaluation_score": {
      "type": "object",
      "description": "Individual evaluator score within an evaluation result.",
      "required": ["name", "score"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Evaluator name (e.g., 'performance', 'safety')"
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Normalized score"
        },
        "unit": {
          "type": "string",
          "description": "Measurement unit"
        },
        "details": {
          "type": "string",
          "description": "Human-readable detail"
        }
      },
      "additionalProperties": false
    },
    "regression_rules": {
      "type": "object",
      "description": "Quality gate constraints for CI/CD integration.",
      "properties": {
        "min_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Fail if overall quality score is below this threshold"
        },
        "max_drop": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Fail if score drop between baseline and candidate exceeds this ratio"
        },
        "require_safety": {
          "type": "boolean",
          "description": "Fail if safety evaluator score is not 1.0"
        }
      },
      "additionalProperties": false
    }
  }
}
